# NCG Invoice Pipeline — Environment Variables
# Copy to .env and fill in real values. Never commit .env to git.
# chmod 600 .env after creation.

# ─── Microsoft Graph (email access) ──────────────────────────────────────────
# Azure AD app registration for invoices@northwindcg.example shared inbox
MS_TENANT_ID=your-azure-tenant-id
MS_CLIENT_ID=your-app-client-id
MS_CLIENT_SECRET=your-client-secret
INVOICE_MAILBOX=invoices@northwindcg.example

# JSON map of Exchange folder IDs to display names (subfolders to poll)
# INVOICE_SUBFOLDER_IDS={"folder-id-1":"Folder Name","folder-id-2":"Folder Name"}

# ─── Supabase (PostgreSQL) ───────────────────────────────────────────────────
# Connection string from Supabase project → Settings → Database → Connection string
SUPABASE_DB_URL=

# Local Postgres backup used by nightly maintenance. PGPASSWORD is required.
PGHOST=
PGPORT=
PGDATABASE=
PGUSER=
PGPASSWORD=

# ─── Anthropic (AI classification + extraction) ──────────────────────────────
# Dedicated API key for invoice pipeline ONLY — do not share with other services
ANTHROPIC_API_KEY=

# ─── Spectrum ERP ─────────────────────────────────────────────────────────────
# Viewpoint Spectrum REST API settings. User and password are required; no defaults are provided.
SPECTRUM_REST_URL=https://your-tenant.dexterchaney.example:8482
SPECTRUM_REST_USER=
SPECTRUM_REST_PASS=

# ─── Server ──────────────────────────────────────────────────────────────────
INVOICE_SERVER_PORT=3456

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Shared secret between Vercel frontend proxy and this backend.
# Must match INTERNAL_API_SECRET on Vercel.
INTERNAL_API_SECRET=generate-with-openssl-rand-hex-32

# NextAuth v4 JWT signing secret. Must match NEXTAUTH_SECRET on Vercel.
NEXTAUTH_SECRET=your-nextauth-secret

# Comma-separated admin emails for hard-delete access.
# Default: admin@example.com
ADMIN_EMAIL=admin@example.com

# ─── Discord ─────────────────────────────────────────────────────────────────
# Channel ID for #accounting notifications
DISCORD_CHANNEL=100000000000000001

# ─── Optional ─────────────────────────────────────────────────────────────────
# Set to "1" to log auth check details (don't use in production)
# DEBUG_AUTH=1

# Minimum characters for OCR to be considered valid (default: 50)
# INVOICE_OCR_MIN_CHARS=50

# LLM gateway (only needed if using gateway-routed LLM calls)
# LLM_GATEWAY_URL=
# LLM_GATEWAY_MODEL=
# LLM_GATEWAY_TOKEN=
